{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://westkitty.github.io/Dex-Video-Code/schemas/creative-job.v1.1.schema.json",
  "title":"Dex Video Code Creative Job v1.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","job_id","source_prompt","brief","creative_intent","route_decision","render_plan","shots_or_beats","assets","execution_plan","artifacts","proof"],
  "properties":{
    "schema_version":{"const":"1.1"},"job_id":{"type":"string","pattern":"^dv_[a-z0-9-]{8,48}$"},"source_prompt":{"type":"string","minLength":1},
    "brief":{"type":"object","additionalProperties":false,"required":["deliverable_type","format","aspect_ratio","duration_seconds","tone","exclusions","captions"],"properties":{"deliverable_type":{"enum":["video","image","audio","scene","document","unknown"]},"format":{"type":"string"},"aspect_ratio":{"type":"string","pattern":"^[0-9]+:[0-9]+$"},"duration_seconds":{"type":"number","minimum":0,"maximum":3600},"tone":{"type":"string"},"exclusions":{"type":"array","items":{"type":"string"}},"captions":{"enum":["off","on","unspecified"]}}},
    "creative_intent":{"type":"object","additionalProperties":false,"required":["subject","setting","actions","purpose","style","audio","technique","proof_requirements","text_policy","requested_constraints","uncertainties"],"properties":{"subject":{"type":"string"},"setting":{"type":"string"},"actions":{"type":"array","items":{"type":"string"}},"purpose":{"type":"string"},"style":{"type":"string"},"audio":{"type":"string"},"technique":{"type":"string"},"proof_requirements":{"type":"array","items":{"type":"string"}},"text_policy":{"enum":["no_text","text_allowed","unspecified"]},"requested_constraints":{"type":"array","items":{"type":"string"}},"uncertainties":{"type":"array","items":{"type":"string"}}}},
    "route_decision":{"type":"object","additionalProperties":false,"required":["selected","status","alternatives","reason","evidence"],"properties":{"selected":{"type":"string"},"status":{"enum":["READY","BLOCKED","NEEDS_CLARIFICATION"]},"alternatives":{"type":"array","items":{"type":"string"}},"reason":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}}}},
    "render_plan":{"type":"object","additionalProperties":false,"required":["kind","shape","palette","fps","width","height"],"properties":{"kind":{"enum":["signal_path","shape_transformation","shape_rotation","none"]},"shape":{"enum":["circle","square","triangle","signal"]},"source_shape":{"enum":["circle","square","triangle"]},"shape_transform_mode":{"enum":["continuous_circle_square_v1"]},"title_text":{"type":"string"},"palette":{"type":"array","items":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"}},"fps":{"type":"integer","minimum":1,"maximum":120},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1}}},
    "shots_or_beats":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["start","end","purpose","visual_state"],"properties":{"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0},"purpose":{"type":"string"},"visual_state":{"type":"string"},"continuity":{"type":"string"},"sound":{"type":"string"}}}},
    "assets":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["asset_id","sha256","rights","source"],"properties":{"asset_id":{"type":"string"},"sha256":{"type":["string","null"]},"rights":{"type":"string"},"source":{"type":"string"},"derived_from":{"type":"array","items":{"type":"string"}}}}},
    "execution_plan":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["operation","adapter","approval","timeout_seconds"],"properties":{"operation":{"type":"string"},"adapter":{"type":"string"},"approval":{"enum":["not_required","required"]},"timeout_seconds":{"type":"integer","minimum":1,"maximum":300}}}},
    "artifacts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["role","format","path"],"properties":{"role":{"type":"string"},"format":{"type":"string"},"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "proof":{"type":"object","additionalProperties":false,"required":["technical_status","artistic_status","evidence"],"properties":{"technical_status":{"type":"string"},"artistic_status":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}}}}
  }
}
