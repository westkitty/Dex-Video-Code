{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://westkitty.github.io/Dex-Video-Code/schemas/creative-job.v1.schema.json",
  "title": "Dex Video Code Creative Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "source_prompt", "brief", "route_decision", "shots_or_beats", "assets", "execution_plan", "artifacts", "proof"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "pattern": "^dv_[a-z0-9-]{8,48}$" },
    "source_prompt": { "type": "string", "minLength": 1 },
    "brief": {
      "type": "object", "additionalProperties": false,
      "required": ["deliverable_type", "format", "aspect_ratio", "duration_seconds", "tone", "exclusions", "captions"],
      "properties": {
        "deliverable_type": { "enum": ["video", "image", "audio", "scene", "document"] },
        "format": { "type": "string", "minLength": 1 }, "aspect_ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "duration_seconds": { "type": "number", "minimum": 0, "maximum": 3600 }, "tone": { "type": "string" },
        "exclusions": { "type": "array", "items": { "type": "string" } }, "captions": { "const": "off" }
      }
    },
    "route_decision": { "type": "object", "required": ["selected", "alternatives", "reason", "evidence"], "properties": { "selected": { "type": "string" }, "alternatives": { "type": "array", "items": { "type": "string" } }, "reason": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } } },
    "shots_or_beats": { "type": "array", "items": { "type": "object", "required": ["start", "end", "purpose", "visual_state"], "properties": { "start": { "type": "number" }, "end": { "type": "number" }, "purpose": { "type": "string" }, "visual_state": { "type": "string" }, "continuity": { "type": "string" }, "sound": { "type": "string" } } } },
    "assets": { "type": "array", "items": { "type": "object", "required": ["asset_id", "sha256", "rights", "source"], "properties": { "asset_id": { "type": "string" }, "sha256": { "type": ["string", "null"] }, "rights": { "type": "string" }, "source": { "type": "string" }, "derived_from": { "type": "array", "items": { "type": "string" } } } } },
    "execution_plan": { "type": "array", "items": { "type": "object", "required": ["operation", "adapter", "approval", "timeout_seconds"], "properties": { "operation": { "type": "string" }, "adapter": { "type": "string" }, "approval": { "enum": ["not_required", "required", "granted"] }, "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 } } } },
    "artifacts": { "type": "array", "items": { "type": "object", "required": ["role", "format", "path"], "properties": { "role": { "type": "string" }, "format": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string" } } } },
    "proof": { "type": "object", "required": ["technical_status", "artistic_status", "evidence"], "properties": { "technical_status": { "type": "string" }, "artistic_status": { "type": "string" }, "evidence": { "type": "array", "items": { "type": "string" } } } }
  }
}
